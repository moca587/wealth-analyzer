# ─────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# Never commit .env.local — it's gitignored.
# ─────────────────────────────────────────────────────────────────

# Supabase — get these from your Supabase dashboard:
#   Settings → API → Project URL
#   Settings → API → Project API keys → anon public
#   Settings → API → Project API keys → service_role (SECRET — server only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-secret

# Application URL (used for OAuth redirects + email templates)
# Dev: http://localhost:3000
# Prod: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────
# Avaloq core-banking integration (SERVER-ONLY — never NEXT_PUBLIC_*)
# Leave these unset to disable the integration: /api/avaloq/sync then
# returns 501 and the app runs on manual entry as before.
# Obtain these from your Avaloq partner portal / API gateway admin.
# ─────────────────────────────────────────────────────────────────
AVALOQ_API_BASE_URL=https://api.YOUR-BANK.avaloq.com/v1
AVALOQ_TOKEN_URL=https://auth.YOUR-BANK.avaloq.com/oauth2/token
AVALOQ_CLIENT_ID=your-oauth-client-id
AVALOQ_CLIENT_SECRET=your-oauth-client-secret
# Optional:
AVALOQ_SCOPE=partners.read accounts.read positions.read credits.read
AVALOQ_API_VERSION=
