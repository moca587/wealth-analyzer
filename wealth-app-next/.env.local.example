# ─────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# Never commit .env.local — it's gitignored.
# ─────────────────────────────────────────────────────────────────

# Supabase — get these from your Supabase dashboard:
#   Settings → API → Project URL
#   Settings → API → Project API keys → anon public
#
# REGION: create the project in Central EU (Frankfurt / eu-central-1).
# Decided 2026-08-05 — client data must stay in the EU per the privacy
# policy, and the region is fixed at creation. See docs/deploy-runbook.md §0.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key

# OPTIONAL: address the SERVER uses to reach Supabase when it differs from the
# one the browser uses (e.g. docker compose: browser http://localhost:54321,
# app container http://kong:8000). Server-side only; unset = use the URL above.
# SUPABASE_INTERNAL_URL=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is deliberately NOT listed. No code reads
# it, and it bypasses every RLS policy in migrations 006-010 — the entire
# tenancy model. Do not provision it until something actually needs it.

# Application URL (used for OAuth redirects + email templates)
# Dev: http://localhost:3000
# Prod: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Feed relay (/api/feeds) ──────────────────────────────────────
# Encrypts custodian/CRM credentials at rest (AES-256-GCM). Without it
# the relay REFUSES to store a secret rather than persisting it in the
# clear, so saving an authenticated connection will fail with a 503.
# Generate:  openssl rand -base64 32
# Rotating this key makes existing stored credentials undecryptable —
# they must be re-entered.
FEEDS_ENCRYPTION_KEY=

# OPTIONAL but recommended in production: restrict which hosts the relay
# may fetch from. Comma-separated; subdomains of a listed host are
# allowed. When empty, any public address is permitted (private,
# loopback, link-local and cloud-metadata ranges are ALWAYS blocked —
# see lib/feeds/ssrf.ts).
# FEEDS_HOST_ALLOWLIST=api.custodian.com,crm.example.com

# ── Order routing (/api/orders) ─────────────────────────────────────
# Hosts the relay may POST order tickets to, comma-separated.
#
# REQUIRED IN PRODUCTION. The SSRF guard accepts a small residual DNS-rebinding
# window on the grounds that a feed read only ever READS from hosts already
# reachable. That reasoning does not carry to the order path: there, a bypass
# delivers a JSON body to an internal endpoint, and writing is not recoverable.
# Pinning to named hosts closes it — rebinding cannot help an attacker whose
# target was never on the list.
#
# Subdomains of a listed entry are allowed. Unset in development only.
ORDERS_HOST_ALLOWLIST=

# ── Billing (/api/billing) — OPTIONAL ───────────────────────────────
# Billing is OFF unless STRIPE_SECRET_KEY is set. A pilot or self-hosted
# install billed by agreement simply leaves these unset, and every firm is
# treated as entitled. Set BILLING_ENFORCED=false to keep billing visible
# but not gating.
#
# When you DO turn billing on, all four are effectively required together —
# lib/env.ts makes the gaps FATAL at boot, because a half-configured
# billing setup takes a customer's money (checkout works) while the webhook
# can never write is_paid, so they pay and stay locked out.
#
# STRIPE_SECRET_KEY        — sk_live_… / sk_test_…  (server only)
# STRIPE_WEBHOOK_SECRET    — whsec_…  the endpoint secret for /api/billing/webhook
# STRIPE_PRICE_ID          — price_…  the recurring per-seat price to sell
# SUPABASE_SERVICE_ROLE_KEY — the ONLY place this key is used: the webhook,
#                             which writes is_paid (a column no user may write).
#                             It bypasses RLS — server env ONLY, never the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# SUPABASE_SERVICE_ROLE_KEY=
