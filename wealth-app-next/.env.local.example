# ─────────────────────────────────────────────────────────────────
# COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES
# Never commit .env.local — it's gitignored.
# ─────────────────────────────────────────────────────────────────

# Supabase — get these from your Supabase dashboard:
#   Settings → API → Project URL
#   Settings → API → Project API keys → anon public
#   Settings → API → Project API keys → service_role (SECRET — server only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-secret

# Application URL (used for OAuth redirects + email templates)
# Dev: http://localhost:3000
# Prod: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Feed relay (/api/feeds) ──────────────────────────────────────
# Encrypts custodian/CRM credentials at rest (AES-256-GCM). Without it
# the relay REFUSES to store a secret rather than persisting it in the
# clear, so saving an authenticated connection will fail with a 503.
# Generate:  openssl rand -base64 32
# Rotating this key makes existing stored credentials undecryptable —
# they must be re-entered.
FEEDS_ENCRYPTION_KEY=

# OPTIONAL but recommended in production: restrict which hosts the relay
# may fetch from. Comma-separated; subdomains of a listed host are
# allowed. When empty, any public address is permitted (private,
# loopback, link-local and cloud-metadata ranges are ALWAYS blocked —
# see lib/feeds/ssrf.ts).
# FEEDS_HOST_ALLOWLIST=api.custodian.com,crm.example.com
